{
  "rules": {
    ".read": false,
    ".write": false,
    "Client_Available_Pytacte_Servers": {
      ".indexOn": [
        "server_id",
        "server_address",
        "tls"
      ],
      "$serverAddress": {
        "server_id": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isString()"
        },
        "server_address": {
          ".read": "auth != null",
          ".write": false,
          ".validate": "newData.isString()"
        },
        "tls": {
          ".read": "auth != null",
          ".write": false,
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "ServerAvailability": {
      ".indexOn": [
        "server_id",
        "server_address",
        "tls",
        "cpu_usage",
        "ram_usage",
        "load_balancer",
        "last_heartbeat"
      ],
      "$serverId": {
        "server_id": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isString()"
        },
        "server_address": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isString()"
        },
        "tls": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isBoolean()"
        },
        "cpu_usage": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isNumber()"
        },
        "ram_usage": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isNumber()"
        },
        "load_balancer": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isBoolean()"
        },
        "last_heartbeat": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isNumber()"
        }
      }
    },
    "TranscriptionJobs": {
      ".indexOn": [
        "transcription_id",
        "uuid",
        "server_id",
        "last_heartbeat"
      ],
      "$transcriptionId": {
        "transcription_id": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isString()"
        },
        "uuid": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isString()"
        },
        "server_id": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isString()"
        },
        "last_heartbeat": {
          ".read": false,
          ".write": false,
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
